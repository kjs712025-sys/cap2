GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_URL=https://gemini.googleapis.com/v1/models/{model}:generate
ROBOT_SIMULATION=0
ROBOT_CAMERA_SOURCE=pi
ROBOT_CAMERA_INDEX=0
ROBOT_FIRE_MODEL_PATH=models/fire_detection/fire_ncnn_model
ROBOT_UART_PORT=/dev/serial0
ROBOT_UART_BAUDRATE=115200