[Unit]
Description=OmniBot Dashboard and Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/meka/.copilot/chats/a183ea76-71db-4dd7-a682-958de50c39ec/cap2-main
EnvironmentFile=/home/meka/.copilot/chats/a183ea76-71db-4dd7-a682-958de50c39ec/cap2-main/.env
Environment=ROBOT_HOST=0.0.0.0
Environment=ROBOT_PORT=8000
Environment=ROBOT_AUTOSTART_AUTONOMOUS=0
Environment=ROBOT_NAV_AUTOSTART=0
Environment=ROBOT_SKIP_PIP=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/meka/.copilot/chats/a183ea76-71db-4dd7-a682-958de50c39ec/cap2-main/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
User=meka
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
